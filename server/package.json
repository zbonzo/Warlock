{
  "name": "warlock-game-server",
  "version": "2.0.0",
  "description": "Server for the Warlock multiplayer game",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "jest --selectProjects server --config ../jest.config.js",
    "test:watch": "jest --selectProjects server --config ../jest.config.js --watch",
    "test:coverage": "jest --selectProjects server --config ../jest.config.js --coverage",
    "build:ts": "npx tsc --build",
    "dev": "nodemon --config nodemon.ts.json --exec \"tsx index.ts\"",
    "dev:ts": "nodemon --config nodemon.ts.json --exec \"tsx index.ts\"",
    "start": "tsx index.ts",
    "start:ts": "tsx index.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "nodemon": "^3.1.10",
    "typescript": "^5.8.3"
  }
}
